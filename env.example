# Copia este archivo como .env.local y completa los valores reales.

# Supabase publico, usado por la app Next.js en cliente y servidor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxx

# Mapbox, requerido para el mapa de /mapa.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxx

# Activa datos ficticios locales y login demo sin depender de Supabase.
NEXT_PUBLIC_DEMO_MODE=false

# Solo para scripts administrativos locales como scripts/seed-users.mjs.
# No expongas esta key en el frontend ni la subas con valores reales.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxx
